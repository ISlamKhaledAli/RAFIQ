# ==============================================================================
#  رفيق لنقاط البيع وإدارة السوبرماركت (Rafiq POS) - نموذج المتغيرات البيئية
#  Unified Project Environment Configuration Template (.env.example)
# ==============================================================================
#  انسخ هذا الملف إلى .env وقم بتعديل القيم حسب بيئة التشغيل الخاصة بك:
#  copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. البيئة العامة ومعلومات التطبيق (General App Configuration)
# ------------------------------------------------------------------------------
RAFIQ_ENV=development
APP_NAME="رفيق - Rafiq POS"
APP_VERSION=1.0.0
APP_BUILD_NUMBER=20260929
APP_LOCALE=ar-EG
APP_TIMEZONE=Africa/Cairo
APP_CURRENCY=EGP
APP_CURRENCY_SYMBOL=ج.م
APP_FRACTION_UNIT=piaster

# ------------------------------------------------------------------------------
# 2. واجهة المستخدم - React & Vite (Frontend Configuration)
# ------------------------------------------------------------------------------
VITE_APP_TITLE="رفيق لنقاط البيع وإدارة السوبرماركت"
VITE_APP_VERSION=1.0.0
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173
VITE_TARGET_BROWSER=chrome109
VITE_LICENSE_SERVER_URL=https://rafiq-license-server.khaledislam9003.workers.dev
VITE_ENABLE_DEV_TOOLS=true

# ------------------------------------------------------------------------------
# 3. سيرفر التراخيص السحابي - Cloudflare Workers & D1 (License Architecture)
# ------------------------------------------------------------------------------
LICENSE_SERVER_URL=https://rafiq-license-server.khaledislam9003.workers.dev
LICENSE_SERVER_LOCAL_URL=http://localhost:8787
LICENSE_SERVER_ENV=production
APP_API_KEY=rafiq_pos_client_secret_k9x2m4p8
ADMIN_SECRET=your_admin_secret_key_here
TOKEN_SIGNING_SECRET=your_hmac_signing_secret_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_D1_DATABASE_NAME=rafiq-licenses
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
LICENSE_HTTP_TIMEOUT_MS=8000
LICENSE_PERIODIC_CHECK_INTERVAL_MIN=15
LICENSE_EXPIRED_CHECK_INTERVAL_MIN=1
LICENSE_GRACE_PERIOD_DAYS=7

# ------------------------------------------------------------------------------
# 4. مضيف سطح المكتب - C# .NET 4.8 & WebView2 (Desktop Runtime)
# ------------------------------------------------------------------------------
RAFIQ_DESKTOP_TARGET=net48
RAFIQ_WEBVIEW2_VERSION=1.0.1518.46
RAFIQ_DEV_HOST_URL=http://localhost:5173
RAFIQ_SINGLE_INSTANCE_MUTEX=RafiqPOS_SingleInstance_Mutex_2026
RAFIQ_MAX_RAM_MB=250
RAFIQ_MIN_SCREEN_WIDTH=1024
RAFIQ_MIN_SCREEN_HEIGHT=768

# ------------------------------------------------------------------------------
# 5. قاعدة البيانات المحلية - SQLite WAL (Database Settings)
# ------------------------------------------------------------------------------
SQLITE_DB_NAME=rafiq_pos.db
SQLITE_PROD_DATA_DIR=%ProgramData%\RafiqPOS\data
SQLITE_DEV_DATA_DIR=./data
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_FOREIGN_KEYS=ON
SQLITE_BUSY_TIMEOUT=5000
SQLITE_BACKUP_DIR=%ProgramData%\RafiqPOS\backups
SQLITE_MAX_BACKUP_RETENTION=30

# ------------------------------------------------------------------------------
# 6. الأمان والتشفير والمصادقة (Security, Hashing & Auth)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PIN=1234
LOCAL_ENCRYPTION_PEPPER=your_local_encryption_salt_here
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=5
AUDIT_LOG_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 7. الأجهزة الطرفية ونقاط البيع (Hardware, Printers, Scanners & Scales)
# ------------------------------------------------------------------------------
PRINTER_THERMAL_DEFAULT_NAME=
PRINTER_PAPER_WIDTH_MM=80
PRINTER_AUTO_CUT_PAPER=true
PRINTER_OPEN_CASH_DRAWER=true
PRINTER_DRAWER_PULSE_PIN=2
BARCODE_SCANNER_DELAY_MS=50
SCALE_COM_PORT=COM1
SCALE_BAUD_RATE=9600
SCALE_DATA_BITS=8
SCALE_PARITY=None
SCALE_STOP_BITS=One

# ------------------------------------------------------------------------------
# 8. التثبيت ومعلومات الدعم الفني (Installer & Support Info)
# ------------------------------------------------------------------------------
INSTALLER_OUTPUT_DIR=./installer/Output
INSTALLER_APP_VERSION=1.0.0
SUPPORT_PHONE=+201000000000
SUPPORT_WHATSAPP=+201000000000
SUPPORT_EMAIL=support@rafiqpos.com
SUPPORT_WEBSITE=https://rafiqpos.com
SUPPORT_DOCS_URL=https://github.com/ISlamKhaledAli/RAFIQ
