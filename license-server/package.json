{
  "name": "rafiq-license-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker + D1 Licensing & Device Activation Server for Rafiq POS",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init-local": "wrangler d1 execute rafiq-licenses --local --file=./schema.sql",
    "d1:init-remote": "wrangler d1 execute rafiq-licenses --remote --file=./schema.sql",
    "test": "node --experimental-strip-types --test test/server.test.ts"
  },
  "keywords": [
    "rafiq-pos",
    "cloudflare-workers",
    "d1",
    "licensing",
    "activation"
  ],
  "author": "Rafiq POS Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.109.0"
  }
}
