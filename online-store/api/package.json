{
  "name": "rafiq-store-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker + D1 Multi-Tenant Online Store API for Rafiq POS",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init-local": "wrangler d1 execute rafiq-stores-db --local --file=./schema.sql",
    "d1:init-remote": "wrangler d1 execute rafiq-stores-db --remote --file=./schema.sql",
    "test": "node --experimental-strip-types --test test/api.test.ts"
  },
  "keywords": [
    "rafiq-pos",
    "online-store",
    "cloudflare-workers",
    "d1",
    "r2",
    "e-commerce"
  ],
  "author": "Islam Khaled Ali",
  "license": "UNLICENSED",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.3",
    "typescript": "^5.4.5",
    "wrangler": "^4.149.0"
  }
}
